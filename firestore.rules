rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User private profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User private gameData subcollection
      match /gameData/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public Profiles (for future ranking / social foundation)
    match /publicProfiles/{userId} {
      // Authenticated users can read public profiles
      allow read: if request.auth != null;
      // Only the user themselves can write/update their public profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
