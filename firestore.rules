rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User private profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User private gameData subcollection
      match /gameData/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Classroom seat reservations: authenticated students may inspect one
    // assigned seat, but only its owner can create or update it.
    match /classroomSeats/{seatId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }

    // Public Profiles (for future ranking / social foundation)
    match /publicProfiles/{userId} {
      // Authenticated users can read public profiles
      allow read: if request.auth != null;
      // Only the user themselves can write/update their public profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
